[Unit]
Description=eWeLink Cloud Gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ewelink
Group=ewelink
EnvironmentFile=/etc/ewelink-lan-ctl.env
ExecStart=/usr/bin/env EWELINK_STATE_FILE=/var/lib/ewelink-lan-ctl/state.json /usr/local/bin/ewelink-lan-ctl
Restart=on-failure
RestartSec=5s
StateDirectory=ewelink-lan-ctl
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ewelink-lan-ctl

[Install]
WantedBy=multi-user.target
